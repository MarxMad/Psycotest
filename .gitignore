.DS_Store
.claude/
.venv/
*.pyc
__pycache__/
~$*

# BD SQLite local (no confundir con app/src/data/, código fuente de ítems)
/data/
app/data/
app/.env
app/.env.local
# Cualquier .env en cualquier nivel — nunca deben llegar al repositorio
.env
.env.*
!.env.example
# Metadatos locales de Vercel
.vercel/
**/.vercel/

# Dependencias y build (también en app/.gitignore)
**/node_modules/
**/.next/
**/out/
