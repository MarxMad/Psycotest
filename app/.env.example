# Sistema Psic — variables de entorno (Supabase)
# Copia a .env.local. Nunca commits .env / .env.local.

## Auth (obligatorio; mín. 16 caracteres aleatorios)
AUTH_SECRET=

## Supabase Postgres (OBLIGATORIO)
## Dashboard → Project Settings → Database → Connection string → URI
## En Vercel/serverless usa pooler puerto 6543 (Transaction):
## postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

## Admin inicial (solo si la tabla users está vacía)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

## URL pública
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

## Multi-canal por subdominio (martin.|ceduct.|psicologia.|ige.)
## Local: dejar localhost (usa *.localhost:3000). Prod: sistemapsic.com
ROOT_DOMAIN=localhost

## Clases en vivo BBB (opcional)
BBB_URL=
BBB_SECRET=
BBB_CHECKSUM_ALGORITHM=sha1

## Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

## Aplicar schema en Supabase
# 1) Pegar docs/supabase_init.sql en SQL Editor
# 2) o: export DATABASE_URL='...' && npm run db:push

# ---------------------------------------------------------------- #
# Privy — identidad (quién inicia sesión)
# Crea la app en https://dashboard.privy.io y copia sus claves.
# ---------------------------------------------------------------- #
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Correos con rol de administrador, separados por coma.
# Quien entre con uno de estos correos recibe rol admin automáticamente;
# cualquier otro entra como psicólogo.
ADMIN_EMAILS=

## ——— Cobros con Stripe ———
## Clave de la cuenta. Usa una clave restringida (rk_…) con permisos de
## escritura solo en Checkout Sessions y lectura en Payment Intents, no una
## sk_. En Vercel, márcala como variable sensible.
## Sin esta clave la plataforma sigue funcionando: los pedidos quedan
## pendientes y se cierran por contacto.
STRIPE_SECRET_KEY=

## Secreto de firma del webhook (whsec_…). Sale de crear el endpoint
## https://TU-DOMINIO/api/stripe/webhook en el panel de Stripe, o de
## `stripe listen --forward-to localhost:3000/api/stripe/webhook` en local.
## Sin él no se concede ningún acceso: el webhook es quien cumple los pedidos.
STRIPE_WEBHOOK_SECRET=
