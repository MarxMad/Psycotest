# PsycoTest — variables de entorno

## Auth
AUTH_SECRET=cambia-esto-minimo-16-chars

## Base de datos local (SQLite)
DATABASE_PATH=./data/psycotest.db

## Base de datos producción (Turso / libSQL) — opcional pero recomendado en Vercel
TURSO_DATABASE_URL=libsql://tu-db.turso.io
TURSO_AUTH_TOKEN=

## Admin inicial (se crea en bootstrap si la tabla users está vacía)
DEFAULT_ADMIN_EMAIL=admin@psycotest.local
DEFAULT_ADMIN_PASSWORD=psycotest2026

## Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

## Aplicar schema
# Local:  npm run db:push
# Con Turso: exporta TURSO_* y corre el mismo comando
