# PsycoTest — variables de entorno (plantilla sin secretos)
# Copia a .env.local y rellena los valores. Nunca commits .env / .env.local.

## Auth (obligatorio en producción; mín. 16 caracteres aleatorios)
AUTH_SECRET=

## Base de datos local (SQLite)
DATABASE_PATH=./data/psycotest.db

## Base de datos producción (Turso / libSQL) — opcional pero recomendado en Vercel
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

## Admin inicial (solo si la tabla users está vacía; define tu propia contraseña)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

## Clases en vivo (BigBlueButton) — obligatorio para programar/entrar a salas
## BBB_URL: base del servidor, p.ej. https://bbb.tudominio.com/bigbluebutton
## BBB_SECRET: shared secret de bbb-conf --secret
BBB_URL=
BBB_SECRET=
## Opcional: sha1 (default, más compatible) | sha256
BBB_CHECKSUM_ALGORITHM=sha1

## Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

## Aplicar schema
# Local:  npm run db:push
# Con Turso: exporta TURSO_* y corre el mismo comando
