# Sistema Psic — variables de entorno (Supabase)
# Copia a .env.local. Nunca commits .env / .env.local.

## Auth (obligatorio; mín. 16 caracteres aleatorios)
AUTH_SECRET=

## Supabase Postgres (OBLIGATORIO)
## Dashboard → Project Settings → Database → Connection string → URI
## En Vercel/serverless usa pooler puerto 6543 (Transaction):
## postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

## Admin inicial (solo si la tabla users está vacía)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

## URL pública
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

## ——— Dominios de cada empresa ———
## Un solo despliegue atiende los tres dominios; el panel /admin concentra
## las tres empresas. Solo el dominio, sin https:// ni www.
## Con estos puestos, cada dominio muestra su marca y las secciones de una
## marca (diplomados → CEDUCT, evaluación → Psicología) se abren en el suyo.
NEXT_PUBLIC_DOMINIO_PSICOLOGIA=
NEXT_PUBLIC_DOMINIO_CEDUCT=
NEXT_PUBLIC_DOMINIO_IGE=
## Dominio desde el que se entra al panel (opcional; p. ej. panel.tudominio.mx).
NEXT_PUBLIC_DOMINIO_PANEL=
## Portafolio de Martín con dominio propio (opcional).
NEXT_PUBLIC_DOMINIO_MARTIN=

## Modo anterior por subdominios (martin.|ceduct.|psicologia.|ige.).
## Sigue funcionando para las marcas sin dominio propio.
## Local: dejar localhost (usa *.localhost:3000).
ROOT_DOMAIN=localhost

## ——— Clases en vivo (LiveKit) ———
## Sala de video propia. LiveKit Cloud (cloud.livekit.io → Settings → Keys)
## o un servidor propio. En local: `npm run livekit:dev` y estos valores:
##   LIVEKIT_URL=ws://localhost:7880
##   LIVEKIT_API_KEY=devkey
##   LIVEKIT_API_SECRET=secret-de-desarrollo-livekit-0123456789
## Webhook (asistencia comprobable): https://TU-DOMINIO/api/livekit/webhook
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

## Grabación de clases (opcional): almacenamiento compatible con S3.
## Con Supabase Storage: Storage → S3 Connection → crea llaves de acceso.
## LIVEKIT_GRABACION_URL_PUBLICA es la URL pública del bucket (sin / final).
LIVEKIT_GRABACION_S3_BUCKET=
LIVEKIT_GRABACION_S3_REGION=
LIVEKIT_GRABACION_S3_ENDPOINT=
LIVEKIT_GRABACION_S3_ACCESS_KEY=
LIVEKIT_GRABACION_S3_SECRET=
LIVEKIT_GRABACION_URL_PUBLICA=

## Aplicar schema en Supabase
# 1) Pegar docs/supabase_init.sql en SQL Editor
# 2) o: export DATABASE_URL='...' && npm run db:push

# ---------------------------------------------------------------- #
# Privy — identidad (quién inicia sesión)
# Crea la app en https://dashboard.privy.io y copia sus claves.
# ---------------------------------------------------------------- #
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Correos con rol de administrador, separados por coma.
# Quien entre con uno de estos correos recibe rol admin automáticamente;
# cualquier otro entra como psicólogo.
ADMIN_EMAILS=

## ——— Cobros con Stripe ———
## Clave de la cuenta. Usa una clave restringida (rk_…) con permisos de
## escritura solo en Checkout Sessions y lectura en Payment Intents, no una
## sk_. En Vercel, márcala como variable sensible.
## Sin esta clave la plataforma sigue funcionando: los pedidos quedan
## pendientes y se cierran por contacto.
## Los métodos de pago (tarjeta, meses sin intereses, OXXO, SPEI, Apple Pay,
## Google Pay) se activan en Stripe → Configuración → Métodos de pago; el
## código no los fija.
STRIPE_SECRET_KEY=
## Si cada empresa cobra en su propia cuenta de Stripe (opcional). La marca
## que no tenga clave propia cobra con STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY_PSICOLOGIA=
STRIPE_SECRET_KEY_CEDUCT=
STRIPE_SECRET_KEY_IGE=

## Secreto de firma del webhook (whsec_…). Sale de crear el endpoint
## https://TU-DOMINIO/api/stripe/webhook en el panel de Stripe, o de
## `stripe listen --forward-to localhost:3000/api/stripe/webhook` en local.
## Sin él no se concede ningún acceso: el webhook es quien cumple los pedidos.
## Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
## checkout.session.async_payment_failed, checkout.session.expired, charge.refunded
STRIPE_WEBHOOK_SECRET=
## Con cuentas separadas, cada cuenta registra el mismo endpoint y da su secreto.
STRIPE_WEBHOOK_SECRET_PSICOLOGIA=
STRIPE_WEBHOOK_SECRET_CEDUCT=
STRIPE_WEBHOOK_SECRET_IGE=

## ——— Correo (Resend) ———
## Confirmaciones de pago, códigos de evaluación, invitaciones a cursos y
## campañas promocionales (Panel → Marketing). Sin clave no se manda nada
## (el cobro sigue). Verifica en resend.com/domains el dominio de cada
## remitente: con dominios separados, son tres dominios a verificar.
RESEND_API_KEY=
## Remitente por defecto y, si se quiere, uno por marca.
CORREO_REMITENTE="Avisos <avisos@tudominio.mx>"
## p. ej. "CEDUCT <hola@ceduct.org.mx>": cada empresa escribe desde su dominio.
CORREO_REMITENTE_CEDUCT=
CORREO_REMITENTE_IGE=
CORREO_REMITENTE_PSICOLOGIA=
## A quién avisar de cada venta (si se deja vacío, al correo de contacto).
CORREO_VENTAS=
