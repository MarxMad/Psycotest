# Sistema Psic — variables de entorno
# Copia a .env.local y rellena. Nunca commits .env / .env.local.

## Auth (obligatorio en producción; mín. 16 caracteres aleatorios)
AUTH_SECRET=

## Base de datos — Supabase / Postgres (OBLIGATORIO para persistencia)
## Supabase → Project Settings → Database → Connection string → URI
## Use el pooler (puerto 6543) en Vercel/serverless:
## postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

## Admin inicial (solo si users está vacía)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

## URL pública
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

## Clases en vivo (BigBlueButton) — opcional
BBB_URL=
BBB_SECRET=
BBB_CHECKSUM_ALGORITHM=sha1

## Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

## Local sin Supabase: docker compose up -d
## DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sistemapsic
## Luego: npm run db:push

## (Legacy, ya no se usa) Turso / SQLite
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# DATABASE_PATH=./data/psycotest.db
